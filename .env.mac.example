# Environment Variables for Mac NAS Backup
# Optimized for macOS with Buffalo LinkStation

# NAS Configuration (Mac-specific)
# Your Buffalo NAS hostname
NAS_HOST=LS210XXXX.local
NAS_SHARE=share

# Mac mount point (NAS will be mounted here)
NAS_MOUNT_POINT=/Volumes/BuffaloNAS

# Source paths on your Mac
SOURCE_PATH_BOOKSTACK=/Users/yourname/Documents/projects/bookstack-wiki
SOURCE_PATH_DOCKER=/Users/yourname/docker
SOURCE_PATH_DOCUMENTS=/Users/yourname/Documents

# NAS credentials
NAS_USERNAME=your_nas_username
NAS_PASSWORD=your_nas_password

# Target paths on NAS (will be created automatically)
# These are relative to the mount point
NAS_PATH_BOOKSTACK=${NAS_MOUNT_POINT}/backups/bookstack-wiki
NAS_PATH_DOCKER=${NAS_MOUNT_POINT}/backups/docker
NAS_PATH_DOCUMENTS=${NAS_MOUNT_POINT}/backups/documents

# Email Configuration
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=your_email@gmail.com
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
