# Environment Variables for Bookstack Wiki Backup
# Optimized configuration with organized NAS structure

# NAS Configuration
NAS_BASE=/mnt/nas/backup
NAS_IP=192.168.1.100
NAS_SHARE=backup
NAS_USERNAME=your_username
NAS_PASSWORD=your_password

# Hostname for organization (optional but recommended)
HOSTNAME=myserver

# Source Paths - Organized by category
SOURCE_PATH_BOOKSTACK=/Documents/projects/bookstack-wiki
SOURCE_PATH_DOCKER=/home/user/docker
SOURCE_PATH_PROJECTS=/Documents/projects
SOURCE_PATH_DOCUMENTS=/home/user/Documents

# Target Paths - Auto-created subdirectories under NAS_BASE
# Option 1: Simple flat structure
NAS_PATH=${NAS_BASE}

# Option 2: Organized by hostname (recommended for multiple machines)
# NAS_PATH=${NAS_BASE}/${HOSTNAME}

# Option 3: Date-based organization for versioning
# BACKUP_MONTH=$(date +%Y-%m)
# NAS_PATH=${NAS_BASE}/${BACKUP_MONTH}

# Email Configuration
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=your_email@gmail.com
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
