# Environment Variables for Mac NAS Backup
# Optimized for macOS with Buffalo LinkStation

# NAS Configuration (Mac-specific)
# Your Buffalo NAS hostname (change XXXX to your actual NAS name)
NAS_HOST=LS210XXXX.local
NAS_SHARE=share

# Mac mount point (NAS will be mounted here)
# If mounting via Finder, use: /Volumes/share
# If using mount_smbfs, use: /Volumes/BuffaloNAS
NAS_MOUNT_POINT=/Volumes/share

# Source paths on your Mac (CHANGE 'yourname' to your actual Mac username!)
SOURCE_PATH_BOOKSTACK=/Users/yourname/Documents/projects/bookstack-wiki
SOURCE_PATH_DOCKER=/Users/yourname/docker
SOURCE_PATH_DOCUMENTS=/Users/yourname/Documents

# NAS credentials
NAS_USERNAME=your_nas_username
NAS_PASSWORD=your_nas_password

# Target paths on NAS (will be created automatically)
# IMPORTANT: Use full paths, not variable substitution in .env files
# These paths will be created automatically if they don't exist
NAS_PATH_BOOKSTACK=/Volumes/share/backups/bookstack-wiki
NAS_PATH_DOCKER=/Volumes/share/backups/docker
NAS_PATH_DOCUMENTS=/Volumes/share/backups/documents

# Email Configuration
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=your_email@gmail.com
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
